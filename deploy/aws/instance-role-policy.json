{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DigBackupWriteAndVerify",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::__BUCKET__/backups/*"
    },
    {
      "Sid": "DigBackupListForRestore",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::__BUCKET__",
      "Condition": { "StringLike": { "s3:prefix": ["backups/", "backups/*"] } }
    }
  ]
}
