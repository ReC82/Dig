{
  "name": "dig-game",
  "version": "1.0.0",
  "description": "DIG! — idle clicker game with Node.js + SQLite backend",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "test": "node --test --test-concurrency=1 --test-timeout=120000 test/*.test.js",
    "check": "git ls-files -z '*.js' | xargs -0 -n1 node --check",
    "backup": "node scripts/backup-db.js",
    "restore": "node scripts/restore-db.js",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.0",
    "session-file-store": "^1.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "sharp": "0.35.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
